DISPLAY_NAME=bot-Vortex
DESCRIPTION=Vortex Frequency Panel
MAIN=shardcloud-start.js
LANGUAGE=node
MEMORY=1024
VERSION=recommended
SUBDOMAIN=bot-vortex
CUSTOM_COMMAND=SHARDCLOUD_DEPLOY_MODE=git BUILD_API_ON_STARTUP=true BUILD_WEB_ON_STARTUP=true REQUIRE_BUILT_ASSETS=false REGISTER_COMMANDS_ON_STARTUP=true NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=768 PORT=80 npm start
