
# Public URL used in Discord transcript buttons.
# Use the HTTPS domain/tunnel that points to this bot API, without trailing slash.
# Example: https://vortex-transcript.com
VORTEX_TRANSCRIPT_BASE_URL=

# Optional API port for the transcript/site server.
API_PORT=3000

# MongoDB persistence.
# Use MongoDB Atlas or a local MongoDB URI.
# Example: mongodb+srv://user:password@cluster.mongodb.net/vortex
MONGODB_URI=
MONGODB_REQUIRED=true
