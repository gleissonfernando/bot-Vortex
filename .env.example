
# Public URL used in Discord transcript buttons.
# Use the HTTPS domain/tunnel that points to this bot API, without trailing slash.
# APP_URL is also accepted, but VORTEX_TRANSCRIPT_BASE_URL has priority.
# Example: https://vortex.shardweb.app
VORTEX_TRANSCRIPT_BASE_URL=https://bot-vortex.shardweb.app
APP_URL=https://bot-vortex.shardweb.app

# Optional API port for the transcript/site server.
API_PORT=3000

# MongoDB persistence.
# Use MongoDB Atlas or a local MongoDB URI.
# Example: mongodb+srv://user:password@cluster.mongodb.net/vortex
MONGODB_URI=
MONGODB_DB=vortex_frequency
MONGODB_REQUIRED=false
BOT_MONGODB_REQUIRED=false
MONGODB_MAX_POOL_SIZE=5
MONGODB_MAX_IDLE_TIME_MS=30000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Frequency panel authentication.
# Use private values in production; weak placeholders make the API refuse startup.
SITE_ORIGIN=https://bot-vortex.shardweb.app
JWT_SECRET=replace-with-32-plus-random-characters
INGEST_SECRET=replace-with-32-plus-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-12-plus-random-characters
LOGIN_RATE_LIMIT_WINDOW_MS=600000
LOGIN_RATE_LIMIT_MAX=8

# Discord bot.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=1505924330490695800
DISCORD_CLIENT_SECRET=valor_real_do_client_secret
DISCORD_OAUTH_REDIRECT_URI=https://bot-vortex.shardweb.app/api/auth/discord/callback
DISCORD_GUILD_ID=
APPROVED_SET_CATEGORY_ID=1515044135470497912
REGISTER_COMMANDS_ON_STARTUP=true
ENABLE_PRESENCE_FEATURES=true
DISCORD_CACHE_MAX_MESSAGES=25
DISCORD_CACHE_MAX_GUILD_MEMBERS=100
DISCORD_CACHE_MAX_PRESENCES=50

# Twitch live alerts.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_STREAMERS=
LIVE_ALERT_CHECK_INTERVAL_MS=120000
LIVE_ALERT_WRITE_OFFLINE_HEARTBEAT=false

# Lightweight runtime toggles.
BOT_LIGHT_MODE=true
FIVEM_SYSTEM_ENABLED=true
START_DISCORD_BOT=true
START_FREQUENCY_API=true
START_FREQUENCY_WEB=true
FREQUENCY_DASHBOARD_SYNC=false
FIVEM_STARTUP_SCAN_ENABLED=true
FIVEM_STARTUP_FETCH_PRESENCES=true
FIVEM_POINT_SERVER_NAME=Metropole RP - Season 2!
FIVEM_POINT_SERVER_ALIASES=metropole.gg,Metropole RP,Metropole RP - Season 2
POINT_ONLINE_VOICE_CHANNEL_ID=
POINT_AUTOMATION_INTERVAL_MS=900000
POINT_AUTOMATION_SCAN_FIVEM=true
POINT_AUTOMATION_FETCH_PRESENCES=true
PONTO_PANEL_INTERVAL_MS=120000
PONTO_PANEL_FETCH_PRESENCES=true
PROFILE_ACCESS_REVIEW_ENABLED=false
PROFILE_SYNC_CHANNELS_ON_STARTUP=false
SYNC_CHANNEL_ACCESS_ON_READY=false
FACTION_HIERARCHY_REFRESH_INTERVAL_MS=0
